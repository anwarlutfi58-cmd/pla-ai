<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan &amp; Fitur"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- SISTEM VERSI MODEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Versi Model (Untuk Dilatih)"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Spinner
                android:id="@+id/spinnerVersion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuatVersiBaru"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="+ Baru"
                android:layout_marginStart="8dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambahkan Link Data ke Versi Ini:"
            android:textColor="#2196F3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtGithubRawUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tempel Link Raw GitHub (.json)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:backgroundTint="#2196F3"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncKnowledge"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Tambah Link ke Versi Ini"
            android:backgroundTint="#2196F3"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada data ditarik."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link yang Sudah Ditambahkan di Versi Ini:"
            android:textColor="#FF9800"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/listSources"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchTts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aktifkan Suara AI"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchInternet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Izinkan AI Akses Internet 24 Jam"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopics"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Pilih Versi Model untuk Chat"
            android:backgroundTint="#FF9800"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Kembali ke Beranda"
            android:backgroundTint="#444444"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>