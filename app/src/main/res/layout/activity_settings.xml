<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pengaturan"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchInternet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Izinkan AI Akses Internet 24 Jam"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManageModels"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Unduh / Kelola Model AI"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Kembali ke Beranda"
        android:textSize="16sp"
        app:backgroundTint="#333333"
        app:cornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>